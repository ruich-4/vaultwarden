# Domain only, without https:// or a trailing slash.
VAULT_DOMAIN=vault.example.com

# Generate each independently with: openssl rand -hex 32
# Hex avoids URL-encoding issues in DATABASE_URL. Do not reuse existing passwords.
POSTGRES_PASSWORD=
VAULT_DB_PASSWORD=

# For a NEW installation only: enable briefly to create your account, then disable.
SIGNUPS_ALLOWED=false

# Optional SMTP. Configure these before relying on email verification or email 2FA.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
